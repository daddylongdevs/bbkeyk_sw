# Scratch SignalR hub → APP_CONFIG['websocket-url']
VITE_SCRATCH_WS_URL=https://stg-crashgame-api.dijoker.com/

# Demo Join apiKey → APP_CONFIG['api-key']
VITE_SCRATCH_DEMO_API_KEY=Y2hhaW50YWJsZWV4YWN0anVtcGV4YW1wbGV5b3VuZ2U=
